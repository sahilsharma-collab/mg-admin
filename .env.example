# Backend API base URLs used by the proxy at /api/mg/<upstream>.
# API_BASE_URL / VIP_API_BASE_URL are read on the server only, so they may
# point at an internal address that is never published to the browser. The
# NEXT_PUBLIC_* values below are the fallback and are all that is configured
# today; client code no longer reads either of them.
API_BASE_URL=
VIP_API_BASE_URL=

NEXT_PUBLIC_PROD_URL=
NEXT_PUBLIC_VIP_URL=

# Shared with the API. Every admin request now leaves from this server, so the
# API's per-IP rate limiter would otherwise count the whole panel as a single
# client. The proxy forwards the real client address signed with this secret;
# the API honours the forwarded address only when the secret matches. Leave it
# unset and the header is not sent at all.
ADMIN_PROXY_SECRET=
